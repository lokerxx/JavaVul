<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
    <constant name="struts.devMode" value="true"/>

    <package name="default" namespace="/" extends="struts-default">
        <default-action-ref name="hello"/>
        <action name="hello" class="com.myapp.action.HelloAction">
            <result name="input" type="freemarker">/WEB-INF/content/hello.ftl</result>
            <result name="success" type="freemarker">/WEB-INF/content/hello.ftl</result>
        </action>
    </package>
</struts>
